{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Manifest",
  "description": "Schema for the question_generator manifest.json",
  "type": "object",
  "required": ["entries"],
  "additionalProperties": false,
  "properties": {
    "_comment": {
      "type": "string",
      "description": "Optional documentation comment"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "description": "List of question-set entries",
      "items": {
        "type": "object",
        "required": ["class", "syllabus", "subject", "unit", "folder", "files"],
        "additionalProperties": false,
        "properties": {
          "class": {
            "type": "string",
            "minLength": 1,
            "description": "Class or grade level (e.g. X)"
          },
          "syllabus": {
            "type": "string",
            "minLength": 1,
            "description": "Syllabus board (e.g. ICSE, CBSE)"
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "description": "Subject name (e.g. Biology)"
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "description": "Unit title"
          },
          "folder": {
            "type": "string",
            "minLength": 1,
            "description": "Relative path to the folder inside questions/"
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "description": "JSON filenames inside the folder",
            "items": {
              "type": "string",
              "pattern": "^[\\w\\-]+\\.json$"
            }
          }
        }
      }
    }
  }
}
